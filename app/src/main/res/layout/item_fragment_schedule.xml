<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/circleView"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="@dimen/margin_extra_large"
            android:layout_marginTop="@dimen/margin_normal"
            android:layout_marginEnd="@dimen/margin_normal"
            android:background="@drawable/circle_background"
            android:elevation="@dimen/_1sdp"
            android:translationX="@dimen/_minus9sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="@dimen/_2sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/margin_extra_large"
            android:background="@color/light_orange"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_extra_large"
            android:layout_marginEnd="@dimen/margin_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_mtrack"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/txtTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_normal"
            android:layout_marginEnd="@dimen/margin_small"
            android:padding="@dimen/padding_small"
            android:textColor="@color/pink"
            android:textSize="@dimen/text_size_normal"
            app:layout_constraintEnd_toStartOf="@id/image"
            app:layout_constraintStart_toEndOf="@id/circleView"
            tools:ignore="MissingConstraints"
            tools:text="02:00 pm - 02:50 pm" />

        <TextView
            android:id="@+id/txtHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:maxLines="2"
            android:padding="@dimen/padding_small"
            android:textColor="@color/blue"
            android:textSize="@dimen/text_size_medium"
            app:layout_constraintEnd_toStartOf="@id/image"
            app:layout_constraintStart_toEndOf="@id/circleView"
            app:layout_constraintTop_toBottomOf="@id/txtTime"
            tools:text="Dr.Pawan Goenka -Md,Mahindra &amp; Mahindra" />

        <TextView
            android:id="@+id/txtHeader1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:padding="@dimen/padding_small"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            app:layout_constraintEnd_toStartOf="@id/image"
            app:layout_constraintStart_toEndOf="@id/circleView"
            app:layout_constraintTop_toBottomOf="@id/txtHeader"
            tools:text="Dr.PAWAN GOENKA - MD" />

        <TextView
            android:id="@+id/txtVenue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_location"
            android:drawablePadding="@dimen/padding_small"
            android:maxLines="2"
            android:padding="@dimen/padding_small"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_small"
            app:layout_constraintEnd_toStartOf="@id/image"
            app:layout_constraintStart_toEndOf="@id/circleView"
            app:layout_constraintTop_toBottomOf="@id/txtHeader1"
            tools:text="Venue- Ballroom Level" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/warmGrey"
            app:layout_constraintTop_toBottomOf="@id/txtVenue" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
