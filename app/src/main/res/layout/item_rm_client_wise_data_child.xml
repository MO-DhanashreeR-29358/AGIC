<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/schedule_back"
        tools:ignore="HardcodedText">

        <TextView
            android:id="@+id/tv_fund_representative_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_large"
            android:padding="@dimen/margin_medium"
            android:textColor="@color/dark_blue"
            android:textSize="@dimen/text_size_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/text_label_overview_designation" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClientMeetingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_medium"
            app:layout_constraintTop_toBottomOf="@+id/tv_fund_representative_name"
            app:layout_constraintStart_toStartOf="@id/tv_fund_representative_name"
            tools:listitem="@layout/item_rm_data_child"/>




    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>