<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:background="@color/white"
        tools:ignore="HardcodedText">

        <RadioButton
            android:id="@+id/tv_shiftTime"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center_vertical|start"
            android:paddingStart="@dimen/_5sdp"
            android:text="09.00 AM"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintHorizontal_weight="3"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_roomNumber"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_roomNumber"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center"
            android:text="Room No.-345"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintLeft_toRightOf="@+id/tv_shiftTime"
            app:layout_constraintRight_toLeftOf="@+id/img"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center_vertical|start"
            android:padding="@dimen/_5sdp"
            android:paddingStart="@dimen/_15sdp"
            android:src="@drawable/agic_15"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintLeft_toRightOf="@+id/tv_roomNumber"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_shiftTime,tv_roomNumber" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recAttendees"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_5sdp"
            android:elevation="@dimen/_100sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>