<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:background="@color/white"
        tools:ignore="HardcodedText">

        <View
            android:id="@+id/rabView"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_margin="@dimen/_5sdp"
            android:background="@drawable/bg_light_orange_circle"
            android:elevation="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_shiftTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_shiftTime" />

        <TextView
            android:id="@+id/tv_shiftTime"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/margin_medium"
            android:gravity="center_vertical|start"
            android:text="09.00 AM"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintHorizontal_weight=".2"
            app:layout_constraintStart_toEndOf="@+id/rabView"
            app:layout_constraintEnd_toStartOf="@+id/imageView"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageView"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:padding="@dimen/_3sdp"
            android:scaleType="fitCenter"
            app:layout_constraintHorizontal_weight="0.35"
            android:src="@drawable/ic_1x1_small_h"
            app:layout_constraintStart_toEndOf="@+id/tv_shiftTime"
            app:layout_constraintEnd_toStartOf="@+id/tv_roomNumber"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_roomNumber"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center"
            android:text="Room No.-345"
            android:textColor="@color/dark_purple"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintHorizontal_weight="0.45"
            android:layout_marginEnd="@dimen/margin_medium"
            app:layout_constraintStart_toEndOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_shiftTime,tv_roomNumber" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recAttendees"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_5sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>