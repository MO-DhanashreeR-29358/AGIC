<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".core.MOSLCommonActivity"
        tools:openDrawer="start">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/coordinator_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/white">

                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/app_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.AppBarOverlay"
                    app:elevation="0dp">

                    <androidx.appcompat.widget.Toolbar
                        android:id="@+id/toolBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:theme="@style/ThemeOverlay.MaterialComponents.ActionBar"
                        app:contentInsetStart="4dp"
                        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light">

                        <LinearLayout
                            android:id="@+id/linear_toolbar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="@dimen/img_news_letter"
                                    android:layout_height="@dimen/img_news_letter"
                                    android:layout_gravity="center_vertical"
                                    android:layout_margin="@dimen/margin_small"
                                    android:layout_marginTop="@dimen/edittext_size"
                                    android:src="@drawable/agic_agic" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/img_logo"
                                    android:layout_width="@dimen/img_news_letter"
                                    android:layout_height="@dimen/img_news_letter"
                                    android:layout_gravity="center_vertical"
                                    android:layout_margin="@dimen/margin_small"
                                    android:layout_marginTop="@dimen/edittext_size" />


                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txt_fund_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:ellipsize="marquee"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:scrollHorizontally="true"
                                    android:singleLine="true"
                                    android:textColor="@color/dark_blue"
                                    android:textSize="@dimen/text_size_medium" />

                                <TextView
                                    android:id="@+id/txt_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="@dimen/margin_medium"
                                    android:ellipsize="marquee"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:scrollHorizontally="true"
                                    android:singleLine="true"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/text_size_small" />

                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/img_call"
                                android:layout_width="@dimen/menuIcons"
                                android:layout_height="@dimen/menuIcons"
                                android:layout_gravity="center_vertical"
                                android:layout_margin="@dimen/margin_small"
                                android:src="@drawable/ic_call_green_24dp"
                                android:visibility="gone" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/img_logout"
                                android:layout_width="@dimen/menuIcons"
                                android:layout_height="@dimen/menuIcons"
                                android:layout_gravity="center_vertical"
                                android:layout_margin="@dimen/margin_large"
                                android:src="@drawable/ic_logout_red_24_dp" />

                        </LinearLayout>

                    </androidx.appcompat.widget.Toolbar>

                </com.google.android.material.appbar.AppBarLayout>


                <FrameLayout
                    android:id="@+id/activityFrameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/margin_small"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />


                <com.mosl.app.coreui.views.BlockingProgressLayout
                    android:id="@+id/progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </androidx.coordinatorlayout.widget.CoordinatorLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/toolbar_color"
                android:orientation="horizontal"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/padding_small"
                app:layout_anchorGravity="bottom|center"
                app:tabGravity="fill"
                app:tabIconTint="@color/bottom_tab_white"
                app:tabIndicatorColor="@color/blue"
                app:tabIndicatorHeight="0dp"
                app:tabMode="auto"
                app:tabSelectedTextColor="@color/blue"
                app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
                app:tabTextColor="@color/bottom_tab_white" />

        </LinearLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

</layout>