    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:colorBackground"
        android:padding="@dimen/padding_medium"

        tools:ignore="HardcodedText">

        <ImageView
            android:id="@+id/icon_overview_mctrack"
            android:layout_width="@dimen/_72sdp"
            android:layout_height="@dimen/_72sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mtrack_small"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_overview_designation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mr.Prasan Basu President South Asia, Nielsen"
            android:textColor="@color/blue"
            android:textSize="@dimen/text_size_normal"
            app:layout_constraintEnd_toStartOf="@+id/overview_tv_time_from"
            app:layout_constraintStart_toEndOf="@+id/icon_overview_mctrack"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/overview_tv_time_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="04.00 pm"
            android:textColor="@color/pink"
            android:textSize="@dimen/text_size_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img_overview_more"
            android:layout_width="@dimen/menu_icon"
            android:layout_height="@dimen/menu_icon"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/margin_small"
            android:src="@drawable/ic_more_ver"
            app:layout_constraintStart_toEndOf="@+id/tv_overview_designation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/overview_tv_time_from"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_overview_time_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="04.00 pm"
            android:textColor="@color/pink"
            android:textSize="@dimen/text_size_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_overview_more" />

        <TextView
            android:id="@+id/tv_overview_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mr. Prasan Basu"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_normal"
            app:layout_constraintEnd_toStartOf="@+id/overview_tv_time_from"
            app:layout_constraintStart_toEndOf="@+id/icon_overview_mctrack"
            app:layout_constraintTop_toBottomOf="@+id/tv_overview_designation" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>