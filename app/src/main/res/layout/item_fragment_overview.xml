<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/constrainLaout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:colorBackground"
        android:orientation="horizontal"
        android:padding="@dimen/padding_normal">

        <ImageView
            android:id="@+id/image1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_mtrack_small" />

        <LinearLayout
            android:id="@+id/linear_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_name_post"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mr. Prasan Basu President South Asia, Neilsen"
                android:textColor="@color/blue"
                android:textSize="@dimen/text_size_large" />


            <TextView
                android:id="@+id/txt_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mr. Prasan Basu"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_large" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_from"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04.00 pm"
                android:textColor="@color/dark_purple"
                android:textSize="@dimen/text_size_large" />

            <ImageView
                android:id="@+id/img_more"
                android:layout_width="@dimen/menu_icon"
                android:layout_height="@dimen/menu_icon"
                android:layout_gravity="center_horizontal"
                android:layout_margin="@dimen/margin_small"
                android:layout_weight="1"
                android:src="@drawable/ic_more_ver" />


            <TextView
                android:id="@+id/txt_toEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04.00 pm"
                android:textColor="@color/dark_purple"
                android:textSize="@dimen/text_size_large" />

        </LinearLayout>

    </LinearLayout>

</layout>