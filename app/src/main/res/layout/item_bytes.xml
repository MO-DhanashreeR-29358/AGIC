<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/linLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="horizontal"
            android:padding="@dimen/padding_medium"
            android:weightSum="2"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_bytes_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/margin_small"
                android:layout_weight="0.4"
                android:gravity="end"
                android:textColor="@color/dark_purple"
                android:textSize="@dimen/text_size_small"
                tools:text="@string/text_label_overview_time" />

            <TextView
                android:id="@+id/tv_bytes_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_weight="1.6"
                android:layout_marginStart="@dimen/margin_extra_small"
                android:gravity="start"
                android:textColor="@color/light_black"
                android:textSize="@dimen/text_size_small"
                tools:text="@string/text_label_bytes_desc" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginTop="@dimen/margin_small"
            android:background="@color/warmGrey"
            app:layout_constraintTop_toBottomOf="@+id/linLay" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>