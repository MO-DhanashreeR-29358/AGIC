<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/login_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ic_bg_attendance">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_banner"
                    android:layout_width="@dimen/_200sdp"
                    android:layout_height="@dimen/_200sdp"
                    android:layout_marginVertical="@dimen/_80sdp"
                    android:layout_marginHorizontal="@dimen/_60sdp"
                    android:contentDescription="@string/app_name"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    style="@style/AttendanceApp.Text.Bold"
                    android:id="@+id/tv_user_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/_80sdp"
                    android:layout_marginStart="@dimen/_60sdp"
                    android:layout_marginTop="@dimen/margin_30"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:text="@string/txt_label_user_id"
                    android:gravity="start"
                    android:textSize="@dimen/text_size_medium"
                    android:contentDescription="@string/txt_label_user_id"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tv_password" />

                <androidx.appcompat.widget.AppCompatEditText
                    style="@style/AttendanceApp.EditText"
                    android:id="@+id/et_user_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/_100sdp"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_30"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:maxLength="@integer/max_digit_id"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintStart_toEndOf="@id/tv_user_id"
                    app:layout_constraintBottom_toTopOf="@id/tv_password" />

                <TextView
                    style="@style/AttendanceApp.Text.Bold"
                    android:id="@+id/tv_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/_80sdp"
                    android:layout_marginStart="@dimen/_60sdp"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginBottom="@dimen/margin_large"
                    android:gravity="start"
                    android:text="@string/tv_password"
                    android:textSize="@dimen/text_size_medium"
                    android:contentDescription="@string/tv_password"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/txt_login" />

                <androidx.appcompat.widget.AppCompatEditText
                    style="@style/AttendanceApp.EditText"
                    android:id="@+id/et_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/_100sdp"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginBottom="@dimen/margin_large"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintStart_toEndOf="@id/tv_password"
                    app:layout_constraintBottom_toTopOf="@id/txt_login" />

                <TextView
                    style="@style/AttendanceApp.Text.Bold"
                    android:id="@+id/txt_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_48"
                    android:paddingHorizontal="@dimen/padding_extra_large"
                    android:paddingVertical="@dimen/padding_small"
                    android:background="@drawable/btn_background"
                    android:gravity="center"
                    android:text="@string/text_label_login"
                    android:textAllCaps="true"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
</layout>