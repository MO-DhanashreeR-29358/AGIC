<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/_250sdp"
        android:paddingLeft="@dimen/padding_medium"
        android:paddingRight="@dimen/padding_medium">

        <TextView
            android:id="@+id/tv_schedule_repo_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:paddingLeft="@dimen/padding_extra_small"
            android:paddingRight="@dimen/padding_extra_small"
            android:textColor="@color/dark_blue"
            android:textSize="@dimen/text_size_normal"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints"
            tools:text="@string/text_label_agic" />

        <TextView
            android:id="@+id/tv_schedule_repo_designation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginEnd="@dimen/margin_extra_small"
            android:maxLines="2"
            android:paddingLeft="@dimen/padding_extra_small"
            android:paddingRight="@dimen/padding_extra_small"
            android:paddingBottom="@dimen/padding_medium"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_normal"
            app:layout_constraintTop_toBottomOf="@id/tv_schedule_repo_name"
            tools:ignore="MissingConstraints"
            tools:text="@string/text_label_overview_designation" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
