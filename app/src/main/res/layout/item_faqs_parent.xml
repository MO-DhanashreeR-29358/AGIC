<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="@dimen/padding_normal"
    android:paddingTop="@dimen/padding_normal"
    android:paddingRight="@dimen/padding_normal">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large"
        tools:ignore="MissingConstraints">

        <ImageView
            android:id="@+id/imgProfileIcon"
            android:layout_width="@dimen/img_large_50"
            android:layout_height="@dimen/img_large_50"
            android:layout_marginLeft="@dimen/margin_medium"
            app:srcCompat="@mipmap/ic_launcher_round" />


        <TextView
            android:id="@+id/txtFaqs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_large"
            android:layout_toRightOf="@+id/imgProfileIcon"
            android:textColor="@color/dark_blue"
            android:textSize="@dimen/text_size_small"
            tools:text="Ms.Nandini Maheshwari" />


        <ImageView
            android:id="@+id/icon_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgProfileIcon"
            android:layout_centerHorizontal="true"
            app:srcCompat="@drawable/ic_more_horiz" />


    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>