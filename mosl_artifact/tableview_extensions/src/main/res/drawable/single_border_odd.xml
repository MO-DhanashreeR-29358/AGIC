<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/table_sideline_width">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/table_cell_first_row_border_color"/>
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:right="1dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/table_sideline_width"
                android:color="@color/side_indicator_color"/>
        </shape>
    </item>
    <item
        android:left="@dimen/table_sideline_width"
        android:right="1dp">
        <shape android:shape="rectangle">
            <padding
                android:left="8dp"
                android:right="4dp"/>
            <solid android:color="@color/table_background_color_light"/>
        </shape>
    </item>
</layer-list>